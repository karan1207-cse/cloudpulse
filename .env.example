# CloudPulse configuration — copy to .env and adjust. Placeholders only:
# never commit real values. CloudPulse does not load .env automatically;
# set variables in your shell (see README "Configuration").

# local | production. production forbids CLOUDPULSE_ALLOW_PRIVATE_TARGETS.
CLOUDPULSE_ENV=local
# local (JSON files) | memory | aws (DynamoDB + SNS)
CLOUDPULSE_BACKEND=local
CLOUDPULSE_DATA_DIR=data
# Services are normally added in the dashboard (stored in DATA_DIR or the
# DynamoDB services table). Optionally, also load read-only services from a
# file OR inline JSON (not both):
# CLOUDPULSE_SERVICES_FILE=services.example.json
# CLOUDPULSE_SERVICES=[{"name":"example-site","url":"https://example.com/"}]

CLOUDPULSE_TIMEOUT_SECONDS=5
CLOUDPULSE_FAILURE_THRESHOLD=3
CLOUDPULSE_MAX_REDIRECTS=5
# Only for local testing against controlled endpoints such as 127.0.0.1.
CLOUDPULSE_ALLOW_PRIVATE_TARGETS=false
# Skip a service if it was checked less than N seconds ago (duplicate events).
CLOUDPULSE_MIN_CHECK_INTERVAL_SECONDS=0
CLOUDPULSE_LOG_LEVEL=INFO

# Background checks run by `cloudpulse serve` (seconds, minimum 10).
CLOUDPULSE_CHECK_INTERVAL_SECONDS=60

# Optional admin token (>= 32 characters). When set, adding/editing/deleting/
# checking services requires "Authorization: Bearer <token>"; required for
# `serve --allow-remote`. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# CLOUDPULSE_ADMIN_TOKEN=<generate-a-long-random-token>

# Local dashboard API
CLOUDPULSE_API_HOST=127.0.0.1
CLOUDPULSE_API_PORT=8000
CLOUDPULSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AWS backend (credentials come from the standard chain: SSO/profile/role —
# never put access keys here).
# AWS_REGION=ap-south-1
# CLOUDPULSE_HEALTH_TABLE=cloudpulse-dev-health-checks
# CLOUDPULSE_INCIDENTS_TABLE=cloudpulse-dev-incidents
# CLOUDPULSE_STATE_TABLE=cloudpulse-dev-monitor-state
# CLOUDPULSE_SERVICES_TABLE=cloudpulse-dev-services
# CLOUDPULSE_HISTORY_RETENTION_DAYS=30
# CLOUDPULSE_SNS_TOPIC_ARN=arn:aws:sns:<region>:<account-id>:cloudpulse-dev-alerts
